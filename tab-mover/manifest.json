{
  "manifest_version": 2,
  "name": "Tab Mover",
  "version": "1.0.0",
  "description": "Export all open tabs in order and re-open them in another Firefox.",
  "permissions": ["tabs", "storage", "clipboardWrite"],
  "browser_action": {
    "default_title": "Tab Mover",
    "default_popup": "mover.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-mover@firefox-plus.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  }
}
