+/**
+ * Firefox+: opens the group of the current tab, scrolled to that tab, when the tab tray is opened on the normal tabs
+ * page at its overview. Back still leads to the overview.
+ */
+internal fun TabsTrayState.withFocusedTabGroupOpened(): TabsTrayState {
+    if (
+        backStack != listOf(TabManagerNavDestination.Root) ||
+            selectedPage != Page.NormalTabs ||
+            mode !is TabsTrayState.Mode.Normal
+    ) {
+        return this
+    }
+    val focusedGroup = tabGroupState.groups.firstOrNull { it.isFocused && !it.closed } ?: return this
+    return copy(backStack = backStack + TabManagerNavDestination.ExpandedTabGroup(group = focusedGroup))
+}
