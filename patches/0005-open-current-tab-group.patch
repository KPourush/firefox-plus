+    private fun openFocusedTabGroupOnFirstLoad(
+        state: TabsTrayState,
+        tabGroups: List<TabsTrayItem.TabGroup>,
+    ): List<TabManagerNavDestination> {
+        if (
+            state.hasTabDataLoaded ||
+                state.backStack != listOf(TabManagerNavDestination.Root) ||
+                state.selectedPage != Page.NormalTabs ||
+                state.mode !is TabsTrayState.Mode.Normal
+        ) {
+            return state.backStack
+        }
+        val focusedGroup = tabGroups.firstOrNull { it.isFocused && !it.closed } ?: return state.backStack
+        return state.backStack + TabManagerNavDestination.ExpandedTabGroup(group = focusedGroup)
+    }
