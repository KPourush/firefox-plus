+) {
+    val tileContentDescription =
+        pluralStringResource(
+            id = R.plurals.add_to_exiting_tab_group_content_description,
+            count = tabGroup.tabs.size,
+            tabGroup.title,
+            tabGroup.tabs.size,
+            tabGroup.theme.contentLabel,
+        )
+    val barColor = tabGroup.theme.primary
+
+    Column(
+        modifier =
+            Modifier.fillMaxWidth()
+                .heightIn(min = GRID_TILE_MIN_HEIGHT)
+                .clip(MaterialTheme.shapes.small)
