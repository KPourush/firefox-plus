+/**
+ * Firefox+: remembers when tabs were last added to each group through this sheet, so the sheet can list
+ * the groups you last added to first. Closing, reading or renaming tabs does not change this order.
+ * A group's starting position is Firefox's own last-change time when the sheet first sees it, which also
+ * puts a freshly created group on top.
+ */
+private object TabGroupAddRecency {
+    private const val PREFS_NAME = "firefox_plus_tab_group_add_recency"
+
+    private fun prefs(context: android.content.Context) =
+        context.getSharedPreferences(PREFS_NAME, android.content.Context.MODE_PRIVATE)
+
+    fun sort(context: android.content.Context, groups: List<TabsTrayItem.TabGroup>): List<TabsTrayItem.TabGroup> {
+        val prefs = prefs(context)
+        val stored = prefs.all
+        // Groups seen here for the first time are seeded once with Firefox's last-change time, so that from
+        // then on only adding tabs moves them.
+        val unseen = groups.filter { stored[it.id] !is Long }
+        if (unseen.isNotEmpty()) {
+            val editor = prefs.edit()
+            unseen.forEach { editor.putLong(it.id, it.lastModified) }
+            editor.apply()
+        }
+        return groups.sortedByDescending { (stored[it.id] as? Long) ?: it.lastModified }
+    }
+
+    fun recordAdd(context: android.content.Context, groupId: String, existingGroupIds: Collection<String>) {
+        val prefs = prefs(context)
+        val editor = prefs.edit()
+        // Drop entries for groups that no longer exist.
+        prefs.all.keys.filter { it !in existingGroupIds }.forEach { editor.remove(it) }
+        editor.putLong(groupId, System.currentTimeMillis()).apply()
+    }
+}
 
