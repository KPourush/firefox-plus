 package org.mozilla.fenix.tabstray.redux.reducer
 
+import org.mozilla.fenix.tabstray.data.TabsTrayItem
 import org.mozilla.fenix.tabstray.redux.action.TabSearchAction
+import org.mozilla.fenix.tabstray.redux.state.TabSearchState
 import org.mozilla.fenix.tabstray.redux.state.TabsTrayState
 
 /** Reducer for [TabSearchAction] dispatched from the Tabs Tray store. */
@@ -38,6 +40,39 @@ object TabSearchActionReducer {
             is TabSearchAction.SearchResultClicked -> {
                 state
             }
+
+            is TabSearchAction.SelectAllResultsClicked -> selectAllResults(state)
         }
     }
+
+    private fun selectAllResults(state: TabsTrayState): TabsTrayState {
+        val matches =
+            state.tabSearchState.searchResults
+                .filterIsInstance<TabsTrayItem.Tab>()
+                .filterNot { it.isHomepageItem }
+                .map { it.id }
+                .toHashSet()
+        if (matches.isEmpty()) return state
+
+        val orderedTabs =
+            (state.normalTabsState.items + state.privateBrowsing.tabs)
+                .flatMap { item ->
+                    when (item) {
+                        is TabsTrayItem.Tab -> listOf(item)
+                        is TabsTrayItem.TabGroup -> item.tabs
+                    }
+                }
+                .filter { it.id in matches }
+                .distinctBy { it.id }
+
+        return state.copy(
+            mode =
+                TabsTrayState.Mode.Select(
+                    selectedTabs = LinkedHashSet(orderedTabs),
+                    selectedTabGroups = emptySet(),
+                ),
+            tabSearchState = TabSearchState(query = "", searchResults = emptyList()),
+            backStack = state.popBackStack(),
+        )
+    }
 }
