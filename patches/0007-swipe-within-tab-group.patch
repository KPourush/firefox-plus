+    private fun tabTrayOrder(components: Components): List<String>? {
+        val snapshot = components.tabDataCoordinator.tabsSnapshot.value ?: return null
+        val groupsById = snapshot.tabGroups.associateBy { it.id }
+        val emittedGroups = hashSetOf<String>()
+        val order = mutableListOf<String>()
+        snapshot.normalTabs.forEach { tab ->
+            val group = tab.tabGroupId?.let { groupsById[it] }
+            when {
+                group != null -> {
+                    if (!group.closed && emittedGroups.add(group.id)) {
+                        order.addAll(group.tabIds)
+                    }
+                }
+                snapshot.inactiveTabsEnabled && tab.inactive -> {}
+                else -> order.add(tab.id)
+            }
+        }
+        return order
+    }
