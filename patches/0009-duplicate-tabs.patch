+/** Key under which two URLs count as the same page, or null for pages that are never treated as duplicates. */
+private fun duplicateKey(url: String): String? {
+    if (url.isBlank() || url.startsWith("about:")) return null
+    return url.substringBefore('#').trimEnd('/')
