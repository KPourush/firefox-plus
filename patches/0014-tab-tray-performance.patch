+/**
+ * Firefox+: the parts of a tab the tab tray shows or uses. Other changes, such as a page's loading progress, don't
+ * rebuild the tab list.
+ */
+private data class TrayTabKey(
+    val id: String,
+    val url: String,
+    val title: String,
+    val private: Boolean,
+    val icon: android.graphics.Bitmap?,
+    val mediaPlaying: Boolean,
+    val lastAccess: Long,
+    val createdAt: Long,
+)
+
+private data class TrayDataKey(
+    val selectedTabId: String?,
+    val tabs: List<TrayTabKey>,
+)
+
+private fun TabData.trayKey(): TrayDataKey =
+    TrayDataKey(
+        selectedTabId = selectedTabId,
+        tabs =
+            tabs.map { tab ->
+                TrayTabKey(
+                    id = tab.id,
+                    url = tab.content.url,
+                    title = tab.content.title,
+                    private = tab.content.private,
+                    icon = tab.content.icon,
+                    mediaPlaying =
+                        tab.mediaSessionState?.playbackState ==
+                            mozilla.components.concept.engine.mediasession.MediaSession.PlaybackState.PLAYING,
+                    lastAccess = tab.lastAccess,
+                    createdAt = tab.createdAt,
+                )
+            },
+    )
